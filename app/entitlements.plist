<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Cho phép app ghi vào /var/jb/var/mobile/Library/Preferences (thư mục dùng chung
	     với tweak SpringBoard). Không có các entitlement này app chạy trong sandbox
	     container riêng và chỉ ghi được vào thư mục của chính nó, khiến tweak
	     không đọc được config. -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
</dict>
</plist>
